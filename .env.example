# Copy to .env.local (never commit) and edit. Keeps secrets out of git.
# All variables are optional — the agent talks to any OpenAI-compatible
# endpoint and works with zero config against a local Ollama at :11434.

# Brain endpoint. Examples:
#   http://localhost:11434/v1            (Ollama directly)
#   http://localhost:4143/v1             (this project's gateway aggregator)
#   https://api.openai.com/v1            (any OpenAI-compatible provider)
BP_BASE_URL=http://localhost:4143/v1

# Bearer token for the endpoint (Ollama is keyless; set "" for it)
BP_API_KEY=

# Long-form chat limits
# BP_MODEL=  # global model override
# BP_TIMEOUT=300